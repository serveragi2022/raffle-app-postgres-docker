# ============================================================================
# Copy this file to .env (docker compose reads .env automatically) and fill
# in real values before deploying. Never commit the real .env file.
# ============================================================================

# --- Postgres (used by the app container to connect to the db container) --
POSTGRES_USER=raffle
POSTGRES_PASSWORD=serveradmin
POSTGRES_DB=raffle_db

# Full connection string the Next.js app uses. Inside docker compose, "db"
# is the Postgres service's hostname — leave it as-is unless you rename the
# service in docker-compose.yml.
DATABASE_URL=postgresql://raffle:serveradmin@192.168.101.66:5433/raffle
DATABASE_SSL=false

# --- Sessions ---------------------------------------------------------------
# Random string, at least 32 characters. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=xJ15eouDTBMyllEv+vnCG6wwnskv5fvJyHLJ9wa0fLY=

# --- Initial admin account (used once by `npm run seed:admin`) -------------
ADMIN_EMAIL=admin@agi.com
ADMIN_PASSWORD=Raffle@2026
ADMIN_FULL_NAME=Administrator
ADMIN_ROLE=admin

NODE_ENV=production
